# --- Telegram ---
BOT_TOKEN=123456:ABC...            # @BotFather dan
ADMIN_IDS=111111111                # Telegram ID(lar)ingiz, vergul bilan. Faqat shular botni boshqaradi
WEBAPP_PASSWORD=                   # ixtiyoriy: Web Appni oddiy brauzerda ochish uchun parol

# --- Server ---
PUBLIC_URL=https://lahza.example.com   # HTTPS manzil (Web App va Google OAuth uchun shart)
PORT=3000
DATA_DIR=./data                    # baza, yuklangan va tayyor videolar shu yerda

# --- YouTube (Google Cloud Console -> OAuth client, turi "Web application") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect URI sifatida qo'shing: ${PUBLIC_URL}/oauth/google/callback

# --- AI (lahzalarni baholash, nom/tavsif/teg/prevyu matni) ---
ANTHROPIC_API_KEY=                 # bo'lmasa, oddiy shablonlar ishlatiladi

# --- Ixtiyoriy ---
FONT_PATH=                         # prevyu uchun qalin shrift (.ttf). Bo'sh bo'lsa DejaVu Sans Bold
YTDLP_BIN=yt-dlp
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
